{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@evidence/*": [
        "cognition/evidence/*"
      ],
      "@time/*": [
        "time/*"
      ],
      "@timeframe": [
        "core/contracts/timeframe"
      ]
    },
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*.ts"
  ]
}
